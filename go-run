#!/usr/bin/env bash

# gorun simulates running `go run .` by creating a tempoarary binary
# and also listens for interrupts, Go program termination, or file changes,
# restarting the Go program if any file changes are detected.

# PID for the active instance of the Go program
app_pid=""
VERSION="v1.2.0"
update_target="https://raw.githubusercontent.com/grackleclub/go-run/main/go-run"

help() {
    echo "Usage: go-run [target] [arguments...]|version|update|help"
    echo
    echo "  [target]:     directory containing the Go program to run"
    echo "  [arguments]:  passed through to the Go program, as with 'go run'"
    echo "  version:      print the version of go-run"
    echo "  update:       update go-run to the latest version"
    echo "  help:         print this help message"
    echo
    exit 0
}

version() {
  echo "go-run $VERSION"
}

update() {
  version
  # a managed install is owned by its package manager: overwriting it
  # in place leaves the manager reporting a version it no longer has.
  case "$0" in
    */mise/installs/* | */.asdf/* | */Cellar/* | */homebrew/*)
      echo "go-run looks package-managed: $0"
      echo "Update it with that tool instead (e.g. 'mise upgrade go-run')."
      return 1
      ;;
  esac
  echo "Updating go-run..."
  if ! curl -s "$update_target" > "$0"; then
    echo "Failed to update go-run"
    return 1
  fi
  chmod +x "$0"
  echo "go-run updated"
  "$0" version
  return 0
}

# help
if [[ "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
  help
fi

# version
if [[ "$1" == "-v" || "$1" == "--version" || "$1" == "version" ]]; then
    echo "go-run $VERSION"
    exit 0
fi

## update
if [[ "$1" == "update" ]]; then
  if ! update; then
    exit 1
  fi
  exit 0
fi

# the first argument names the target directory and is consumed here;
# everything left in "$@" belongs to the Go program, matching how
# `go run . -flag` passes -flag to the program rather than to go.
# Read after the subcommands above so `go-run version` still works.
if [[ -z "$1" ]]; then
  target_dir="."
else
  target_dir="$1"
  shift
fi

# `go build example` resolves as an import path and errs "not in std";
# go wants ./example for a directory.
# Rewrite only a real dir.
if [[ -d "$target_dir" && "$target_dir" != /* && "$target_dir" != .* ]]; then
  target_dir="./$target_dir"
fi

# build outside the working tree so the binary neither lands in the
# caller's repo nor trips the file watcher below
tmp_dir=$(mktemp -d)
app_bin="$tmp_dir/app"

# clean up on exit, regardless of cause.
# Set once, at top level, so an early failure doesn't leak the dir
trap 'printf "🚮 Cleaning up temp binary on exit...";
  rm -rf "$tmp_dir";
  printf "bye!\n"' EXIT

# shut the Go program down before leaving, and wait for it, so a
# program with its own graceful shutdown gets to finish. TERM is
# trapped alongside INT so a supervisor cannot orphan the child.
trap 'echo;
  line_break 🚧;
  printf "⛔ Cancelling...\n";
  if [[ -n "$app_pid" ]]; then
    kill "$app_pid" 2>/dev/null;
    wait "$app_pid" 2>/dev/null;
  fi;
  exit' INT TERM


# separate output from this script from the Go program
# by providing a terminal-wide line break with sytlized text
line_break() {
  local title
  title=$(printf " %s %s %s " "$1" "$0" $VERSION "$1")
  local width
  width=$(tput cols)
  local title_length=$(( ${#title} + 2 ))
  local fill_length=$(( (width - title_length) / 2 ))
  printf '%*s' "$fill_length" '' | tr ' ' '-'
  printf '%s' "$title"
  printf '%*s\n' "$fill_length" '' | tr ' ' '-'
}

# use time of last save and list of all files to detect changes.
# inside a repo, ask git for the file list so .gitignore is honored:
# build caches like elm-stuff and node_modules should not trigger a
# rebuild. --others --exclude-standard keeps new, unignored files.
state() {
  if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    git ls-files --cached --others --exclude-standard -z |
      xargs -0 -r stat -c "%Y %n" 2> /dev/null
  else
    find ./* -type f -exec stat -c "%Y %n" {} \;
  fi
}

# run the Go program with passed arguments
run_go_app() {
  # kill by recorded pid, not by name: a name match would also reap
  # unrelated processes of the user's that happen to match.
  if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
    printf "🪓 Killing running Go program..."
    if ! kill "$app_pid" 2>/dev/null; then
      printf "failed. 🤷\n"
      return 1
    fi
    wait "$app_pid" 2>/dev/null
    printf "dead. 💀\n"
  fi

  echo "🏗️  Binary is building..."
  # This is a binary not a 'go run' because it seems that
  # go run creates a temporary binary and then runs it,
  # so we can't capture the PID of the running process.
  #
  # Instead, we simulate go run with our own temp binary.
  if ! go build -o "$app_bin" "$target_dir"; then
    echo "❌ Binary build failed for target directory: \"$target_dir\""
    exit 1
  fi
  echo "✅ Binary is built!"

  echo "🚀 Starting Go app and watching for changes... 👀"
  line_break 🚧

  # echo the command being run
  if [[ -z "$*" ]]; then
    printf "go run %s\n" "$target_dir"
  else
    printf "go run %s %s\n" "$target_dir" "$*"
  fi
  "$app_bin" "$@" &
  app_pid=$!
}

# exit if the app has terminated, passing along exit code
exit_if_done() {
  if ! kill -0 "$app_pid" 2>/dev/null; then
    wait "$app_pid"
    exit_code=$?
    line_break 🚧
    echo "🚫 Go app terminated ($exit_code) exiting..."
    exit "$exit_code"
  fi
  return 0
}

# line breaks help differentiate go-run output from application output
line_break 🚧

# require Go
if ! go_version=$(go version); then
  echo "🧐 Go is not installed or missing from PATH."
  echo "Install go and try again:"
  echo "  https://go.dev"
  echo
  exit 1
else
  echo "🐹 $go_version"
fi

# initial run before listening for any changes
state_old=$(state)
run_go_app "$@"

# continue to watch for changes, restarting or exiting as appropriate
while true; do
  sleep 1
  exit_if_done


  state_new=$(state)
  if [[ "$state_old" != "$state_new" ]]; then
    line_break 🚧
    echo "🔄 File change detected!"

	diff <(echo "$state_old") <(echo "$state_new") | grep -E '^<|>'

    run_go_app "$@"
    state_old=$state_new
  fi
done
